# This file documents server-side variables only. Do not put a real key in
# browser code, committed files, URLs, LocalStorage, or frontend build values.

# 1 for labelled local fixture data, 0 for live TAGO requests.
BUSRO_FIXTURE_MODE=1

# Leave empty in this example. Set the real value only in the server process.
TAGO_SERVICE_KEY=

BUSRO_HOST=127.0.0.1
BUSRO_PORT=8791
TAGO_TIMEOUT_SECONDS=6
# Distinct live cache misses share this process-wide upstream concurrency cap.
BUSRO_TAGO_MAX_CONCURRENT_CALLS=8
# Requests that cannot enter the upstream gate quickly fail with 429.
BUSRO_TAGO_ADMISSION_TIMEOUT_SECONDS=0.25
# Persistent KST-day safety budget. Counted only when a real TAGO call is attempted.
BUSRO_TAGO_DAILY_CALL_BUDGET=9000
BUSRO_CACHE_TTL_SECONDS=30
# Mostly static route/stop catalogs use a longer shared cache to protect TAGO quota.
BUSRO_CATALOG_CACHE_TTL_SECONDS=86400

# Vercel can download one immutable public .tar.gz catalog snapshot at cold start.
# The archive and uncompressed SQLite bytes/SHA-256 must match data/network_catalog.meta.json.
# BUSRO_CATALOG_ARCHIVE_URL=https://github.com/OWNER/REPO/releases/download/TAG/network_catalog-HASH.tar.gz
BUSRO_MAX_BODY_BYTES=65536
# A longer poll gap cannot prove a one-stop passage and is kept as DATA_GAP.
BUSRO_POSITION_GAP_SECONDS=900

# Exact origins only; wildcards are intentionally unsupported.
BUSRO_ALLOWED_ORIGINS=http://127.0.0.1:8289,http://localhost:8289,http://127.0.0.1:8290,http://localhost:8290,http://127.0.0.1:8791,http://localhost:8791
BUSRO_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]

# Required for cost/state-changing operator endpoints when the peer is not
# loopback. Keep empty in this committed example; use 16-256 printable ASCII
# characters in the server process only.
BUSRO_OPERATOR_TOKEN=

# Optional. Omit to use service/data/busro_itda.sqlite3.
# BUSRO_DB_PATH=C:\path\outside\the\frontend\busro_itda.sqlite3
# Dedicated indexed nationwide stop/route catalog. Do not reuse BUSRO_DB_PATH.
# BUSRO_NETWORK_CATALOG_PATH=C:\path\outside\the\frontend\busro_network.sqlite3

# Optional fixture override for schema-only catalog tests. Never point this at
# a browser-writable file in a deployed environment.
# BUSRO_CATALOG_FIXTURE_PATH=C:\path\to\tago_catalog.json
